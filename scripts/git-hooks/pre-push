#!/bin/bash
# Stops what must never reach GitHub (the project guide, "Distribution, policies, and the public
# repo"): a claude/… branch, commits from before the history rewrites (2026-09-30 and 2026-11-05,
# which removed personal details and AI mentions), and new commits that break scripts/lint.sh.
# `git push --no-verify` skips it.
set -euo pipefail
remote="$1"
root=929b90c86949fb5deafbb1f5222e35d0f9917c04   # first commit of the rewritten history
zero=0000000000000000000000000000000000000000
upstream="refs/remotes/$remote/main"
lint="$(git rev-parse --show-toplevel)/scripts/lint.sh"
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue          # deleting a branch
  case "$remote_ref" in
    refs/heads/claude/*) echo "pre-push: no claude/… branches: $remote_ref" >&2; status=1; continue ;;
  esac
  if ! grep -qx "$root" <<< "$(git rev-list --max-parents=0 "$local_sha")"; then
    echo "pre-push: $local_ref comes from the history before the 2026-09-30 rewrite; rebuild it on $remote/main." >&2
    status=1; continue
  fi
  if git rev-parse -q --verify "$upstream" >/dev/null; then
    # A commit whose change is already on main under another id is a copy from before a rewrite.
    copies="$(git cherry "$upstream" "$local_sha" | sed -n 's/^- //p')"
    if [ -n "$copies" ]; then
      echo "pre-push: $local_ref carries old copies of commits already on $remote/main (made before a history rewrite):" >&2
      git log --no-walk --format='  %h %s' $copies >&2
      echo "  Rebase only the new work onto $remote/main." >&2
      status=1; continue
    fi
    base="$upstream"
  else
    base=
  fi
  [ "$remote_sha" != "$zero" ] && base="$remote_sha"
  if [ -n "$base" ] && ! "$lint" --commits "$base..$local_sha"; then status=1; fi
done
exit "$status"

<Project>
  <!-- Shared by every project under WindowsHost/. Projects that need Windows APIs set their own
       TargetFramework (net10.0-windows10.0.26100.0), which overrides the default below. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Interfaces and entry points carry XML docs; message records mirror the Swift types (which
         document them), so a comment isn't forced on every property. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
</Project>

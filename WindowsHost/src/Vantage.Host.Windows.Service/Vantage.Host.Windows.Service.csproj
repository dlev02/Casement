<Project Sdk="Microsoft.NET.Sdk">

  <!-- Casement Host Service: an opt-in Windows service (LocalSystem) that starts the desktop helper
       as SYSTEM in the signed-in console session, so Casement Host can show and control the secure
       desktop (lock screen, administrator prompts) and administrator apps. The same exe installs
       and uninstalls itself (run elevated from the host's folder). Published as one self-contained
       file beside the host (scripts/publish.ps1, make-release.ps1); compiles on macOS. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>Vantage.Host.Windows.Service</RootNamespace>
    <AssemblyName>CasementHostService</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\Vantage.Host.Windows\Assets\Vantage.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vantage.Host.Windows.Platform\Vantage.Host.Windows.Platform.csproj" />
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
    <PackageReference Include="System.ServiceProcess.ServiceController" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

</Project>

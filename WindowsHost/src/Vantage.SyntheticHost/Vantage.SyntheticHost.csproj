<Project Sdk="Microsoft.NET.Sdk">

  <!-- A loopback test host that runs on macOS: the real session logic from Vantage.Protocol with
       a looping pre-encoded H.264 clip, an input log, and an in-memory clipboard. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Vantage.SyntheticHost</RootNamespace>
    <AssemblyName>Vantage.SyntheticHost</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vantage.Protocol\Vantage.Protocol.csproj" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pure code from the Windows platform, so the pretend pointer runs the same pixel path. -->
    <Compile Include="..\Vantage.Host.Windows.Platform\Cursor\CursorImage.cs" Link="Shared\CursorImage.cs" />
    <Compile Include="..\Vantage.Host.Windows.Platform\Clipboard\PngWriter.cs" Link="Shared\PngWriter.cs" />
    <Compile Include="..\Vantage.Host.Windows.Platform\Clipboard\DibCodec.cs" Link="Shared\DibCodec.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Vantage.Protocol.Tests" />
  </ItemGroup>

</Project>

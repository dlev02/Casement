<Project Sdk="Microsoft.NET.Sdk">

  <!-- The console bring-up host: the real Windows pipeline (capture, encode, SendInput, clipboard,
       status) with console logging and no UI. Same composition root as the app. Builds on macOS
       with -p:EnableWindowsTargeting=true (compile-only); runs on Windows. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>Vantage.Host.Windows.Cli</RootNamespace>
    <AssemblyName>VantageHostCli</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\Vantage.Host.Windows\Assets\Vantage.ico</ApplicationIcon>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Lets macOS build it (compile-only) as part of the solution. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vantage.Host.Windows.Platform\Vantage.Host.Windows.Platform.csproj" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>

</Project>

<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Vantage.Host.Windows.App.Pages.GeneralPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel MaxWidth="880" Padding="36,24,36,36" Spacing="12">
            <TextBlock Margin="0,0,0,8" Style="{StaticResource TitleTextBlockStyle}" Text="General" />

            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon x:Name="StatusIcon" FontSize="24" Glyph="&#xE7F4;" />
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock x:Name="StatusText" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                        <TextBlock x:Name="ConnectedText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Tailnet address" />
                    <TextBlock x:Name="AddressText" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                    <TextBlock x:Name="AddressHint" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Pair an iPad" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Add this PC in Vantage on your iPad, then type the code shown here. A code works once, for 10 minutes."
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Button
                        x:Name="ShowCodeButton"
                        Click="OnShowCode"
                        Content="Show Pairing Code"
                        Style="{StaticResource AccentButtonStyle}" />
                    <StackPanel x:Name="CodePanel" Spacing="8" Visibility="Collapsed">
                        <TextBlock
                            x:Name="CodeText"
                            AutomationProperties.Name="Pairing code"
                            CharacterSpacing="300"
                            FontSize="56"
                            FontWeight="SemiBold"
                            IsTextSelectionEnabled="True" />
                        <TextBlock x:Name="CodeExpiry" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Click="OnCopyCode" Content="Copy" />
                            <Button Click="OnNewCode" Content="New Code" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <ToggleSwitch
                    x:Name="StartAtLoginSwitch"
                    Header="Start Vantage Host when I sign in"
                    Toggled="OnStartAtLoginToggled" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

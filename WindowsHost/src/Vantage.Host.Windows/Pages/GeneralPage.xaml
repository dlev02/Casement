<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Vantage.Host.Windows.App.Pages.GeneralPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Vantage.Host.Windows.App"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls">

    <local:PageShell Title="General">
        <StackPanel Spacing="4">
            <InfoBar
                x:Name="ProblemBar"
                Title="Casement Host can't accept connections"
                IsClosable="False"
                Severity="Error" />

            <tk:SettingsCard x:Name="StatusCard">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon x:Name="StatusIcon" Glyph="&#xEC61;" />
                </tk:SettingsCard.HeaderIcon>
                <Button
                    x:Name="PairButton"
                    Click="OnPair"
                    Content="Pair a device"
                    Style="{StaticResource AccentButtonStyle}"
                    Visibility="Collapsed" />
            </tk:SettingsCard>

            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Connection" />
            <tk:SettingsCard x:Name="AddressCard" Header="Tailscale address">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE774;" />
                </tk:SettingsCard.HeaderIcon>
                <tk:SettingsCard.Description>
                    <TextBlock x:Name="AddressText" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                </tk:SettingsCard.Description>
                <Button
                    x:Name="CopyAddressButton"
                    MinWidth="72"
                    AutomationProperties.Name="Copy this PC's Tailscale address"
                    Click="OnCopyAddress"
                    Content="Copy" />
            </tk:SettingsCard>

            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Startup and system tray" />
            <tk:SettingsCard
                x:Name="StartAtLoginCard"
                Description="Keeps running in the system tray when you close this window."
                Header="Start when I sign in">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7E8;" />
                </tk:SettingsCard.HeaderIcon>
                <ToggleSwitch
                    x:Name="StartAtLoginSwitch"
                    AutomationProperties.Name="Start when I sign in"
                    Toggled="OnStartAtLoginToggled" />
            </tk:SettingsCard>
            <tk:SettingsCard x:Name="TrayIconCard" Header="Show the icon next to the clock">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE75B;" />
                </tk:SettingsCard.HeaderIcon>
                <ToggleSwitch
                    x:Name="TrayIconSwitch"
                    AutomationProperties.Name="Show the icon next to the clock"
                    Toggled="OnTrayIconToggled" />
            </tk:SettingsCard>

            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="While a device is connected" />
            <tk:SettingsCard
                Description="Windows stops on its restart screen so someone at the PC can cancel. A forced restart can't be stopped."
                Header="Ask before restarting">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE777;" />
                </tk:SettingsCard.HeaderIcon>
                <ToggleSwitch
                    x:Name="RestartGuardSwitch"
                    AutomationProperties.Name="Ask before restarting while a device is connected"
                    Toggled="OnRestartGuardToggled" />
            </tk:SettingsCard>
            <tk:SettingsCard
                x:Name="AdminCard"
                Description="Includes Task Manager. Windows asks once, then any program you run could use this to get administrator rights without asking, so turn it on only if you need it."
                Header="Control apps running as administrator">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7EF;" />
                </tk:SettingsCard.HeaderIcon>
                <ToggleSwitch
                    x:Name="AdminSwitch"
                    AutomationProperties.Name="Control apps running as administrator"
                    Toggled="OnAdminToggled" />
            </tk:SettingsCard>

            <InfoBar x:Name="AdminFeedback" IsOpen="False" Visibility="Collapsed" IsClosable="True" />

            <StackPanel x:Name="UpdatesSection" Spacing="4" Visibility="Collapsed">
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Updates" />
                <tk:SettingsCard x:Name="UpdateCard">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE895;" />
                    </tk:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ProgressRing
                            x:Name="UpdateProgress"
                            Width="20"
                            Height="20"
                            AutomationProperties.Name="Update progress"
                            Visibility="Collapsed" />
                        <HyperlinkButton
                            x:Name="WhatsNewLink"
                            Click="OnWhatsNew"
                            Content="What's new"
                            Visibility="Collapsed" />
                        <Button x:Name="UpdateButton" Click="OnUpdateButton" />
                    </StackPanel>
                </tk:SettingsCard>
                <tk:SettingsCard
                    Description="Checks GitHub once a day, and installs only while no device is connected."
                    Header="Install updates automatically">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE896;" />
                    </tk:SettingsCard.HeaderIcon>
                    <ToggleSwitch
                        x:Name="AutoUpdateSwitch"
                        AutomationProperties.Name="Install updates automatically"
                        Toggled="OnAutoUpdateToggled" />
                </tk:SettingsCard>
            </StackPanel>
        </StackPanel>
    </local:PageShell>
</Page>

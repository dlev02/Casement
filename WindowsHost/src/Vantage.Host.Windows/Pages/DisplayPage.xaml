<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Vantage.Host.Windows.App.Pages.DisplayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Vantage.Host.Windows.App"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls">

    <local:PageShell Title="Display">
        <StackPanel Spacing="4">
            <tk:SettingsCard x:Name="SharedCard">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7F4;" />
                </tk:SettingsCard.HeaderIcon>
            </tk:SettingsCard>
            <tk:SettingsCard
                Description="This PC's own screen switches resolution and scale while that device is connected, and goes back when it disconnects."
                Header="Let devices fit this PC's display to their screen">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE740;" />
                </tk:SettingsCard.HeaderIcon>
                <ToggleSwitch
                    x:Name="FitSwitch"
                    AutomationProperties.Name="Let devices fit this PC's display to their screen"
                    Toggled="OnFitToggled" />
            </tk:SettingsCard>
            <TextBlock
                Style="{StaticResource SectionFootnoteStyle}"
                Text="Casement shares the main display unless your device picks another one. Windows can't add a virtual display the way a Mac can, so fitting picks the resolution closest to the device's shape and the scale that gives it the room of its own screen." />

            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Advanced" />
            <tk:SettingsExpander Description="How the picture is captured and encoded" Header="Streaming details">
                <tk:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE9D9;" />
                </tk:SettingsExpander.HeaderIcon>
                <tk:SettingsExpander.Items>
                    <tk:SettingsCard x:Name="DeviceSizeCard" Header="Size on your device" />
                    <tk:SettingsCard x:Name="CaptureCard" Header="Capture" />
                    <tk:SettingsCard x:Name="ChangeCard" Header="Finding what changed" />
                    <tk:SettingsCard x:Name="EncoderCard" Header="Video encoder" />
                </tk:SettingsExpander.Items>
            </tk:SettingsExpander>
        </StackPanel>
    </local:PageShell>
</Page>

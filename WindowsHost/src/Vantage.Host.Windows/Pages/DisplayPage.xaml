<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Vantage.Host.Windows.App.Pages.DisplayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel MaxWidth="880" Padding="36,24,36,36" Spacing="12">
            <TextBlock Margin="0,0,0,8" Style="{StaticResource TitleTextBlockStyle}" Text="Display" />

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Shared display" />
                    <TextBlock x:Name="DisplayName" TextWrapping="Wrap" />
                    <TextBlock x:Name="DisplayDetail" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="4">
                    <ToggleSwitch
                        x:Name="FitSwitch"
                        Header="Let devices change this PC's display mode to fit their screen"
                        Toggled="OnFitToggled" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="This PC's own screen switches resolution while that device is connected, and goes back when it disconnects."
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Capture" />
                    <TextBlock x:Name="CaptureText" TextWrapping="Wrap" />
                    <TextBlock x:Name="CaptureDetail" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Video encoder" />
                    <TextBlock x:Name="EncoderText" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Casement shares the main display unless your device picks another one. A device set to match its screen switches the main display to the resolution closest to its own shape, since Windows can't add a virtual display the way a Mac can."
                TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>

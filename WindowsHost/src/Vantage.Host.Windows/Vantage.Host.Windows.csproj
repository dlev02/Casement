<Project Sdk="Microsoft.NET.Sdk">

  <!-- Vantage Host for Windows: the tray app with a WinUI 3 (Windows App SDK 2.5) settings window.
       Unpackaged and self-contained (no MSIX, no installer): publish copies one folder to
       %LOCALAPPDATA%\Programs\Vantage Host. XAML compiles only on Windows, so this project is in
       Vantage.Windows.PC.slnx, not the solution the Mac builds. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>Vantage.Host.Windows.App</RootNamespace>
    <AssemblyName>VantageHost</AssemblyName>
    <!-- What Task Manager and the file's Details tab show. -->
    <AssemblyTitle>Casement Host</AssemblyTitle>
    <Product>Casement Host</Product>
    <Version>1.6</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Vantage.ico</ApplicationIcon>
    <!-- Platform picks the Windows App SDK's native files, not only the exe's: pass the real one
         (make-release.ps1 does), or an ARM package ends up carrying x64 WinUI. -->
    <Platforms>x64;arm64</Platforms>
    <PlatformTarget Condition="'$(Platform)' == 'arm64'">arm64</PlatformTarget>
    <PlatformTarget Condition="'$(Platform)' != 'arm64'">x64</PlatformTarget>
    <RuntimeIdentifier Condition="'$(Platform)' == 'arm64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' != 'arm64'">win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <!-- Program.cs owns Main: single instance (AppInstance) before XAML starts. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <!-- The XAML compiler's generated code has never been built here; turn this back on once the
         PC build is known to be warning-free. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">true</PublishReadyToRun>
    <!-- WinUI and CsWinRT still need care with trimming; the folder is copied, size doesn't matter. -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\Vantage.ico" CopyToOutputDirectory="PreserveNewest" />
    <!-- The icon in the title bar, About and the tray panel (ms-appx:///Assets/…: a relative path in
         Pages\*.xaml resolves under Pages\ and shows nothing). The .ico stays the exe's icon. -->
    <Content Include="Assets\CasementHost.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\CasementHostLight.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\CasementHostDark.png" CopyToOutputDirectory="PreserveNewest" />
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vantage.Host.Windows.Platform\Vantage.Host.Windows.Platform.csproj" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <!-- Windows App SDK 2.x leaves Microsoft.WindowsAppRuntime.Insights.Resource.dll out of the
       self-contained layout, and without it AppNotificationManager.Register() throws "Unable to
       load resource dll" (microsoft/WindowsAppSDK#6774, fixed upstream by #6725 but not in 2.5.1),
       so no toasts. The file ships only inside the runtime MSIX in the Runtime package, next to a
       Microsoft.WindowsAppRuntime.dll identical to the one we deploy: copy it out of there. Drop
       this once a release puts it in the output (or stops needing it). -->
  <PropertyGroup>
    <InsightsResourceDll>Microsoft.WindowsAppRuntime.Insights.Resource.dll</InsightsResourceDll>
  </PropertyGroup>

  <Target Name="AddWindowsAppRuntimeInsightsResource" BeforeTargets="AssignTargetPaths" Condition="'$(WindowsAppSDKSelfContained)' == 'true'">
    <PropertyGroup>
      <InsightsResourceDir>$(IntermediateOutputPath)WindowsAppRuntimeInsights\</InsightsResourceDir>
      <_InsightsMsix>$(MicrosoftWindowsAppSDKPackageDir)tools\MSIX\win10-$(PlatformTarget)\Microsoft.WindowsAppRuntime.2.msix</_InsightsMsix>
    </PropertyGroup>
    <Warning Condition="!Exists('$(_InsightsMsix)')" Text="$(_InsightsMsix) not found, so $(InsightsResourceDll) isn't copied and app notifications may fail. Check whether this Windows App SDK still needs the workaround." />
    <Unzip Condition="Exists('$(_InsightsMsix)')" SourceFiles="$(_InsightsMsix)" DestinationFolder="$(InsightsResourceDir)" Include="$(InsightsResourceDll)" SkipUnchangedFiles="true" />
    <ItemGroup Condition="Exists('$(_InsightsMsix)')">
      <None Include="$(InsightsResourceDir)$(InsightsResourceDll)" Link="$(InsightsResourceDll)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>

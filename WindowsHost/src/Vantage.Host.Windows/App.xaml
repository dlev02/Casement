<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Vantage.Host.Windows.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Vantage.Host.Windows.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                The one layout for the settings window (Windows 11 Settings'): the whole window is Mica,
                so NavigationView's own rounded content panel goes; the cards are then the only surface.
            -->
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />

            <x:Double x:Key="PageMaxWidth">1000</x:Double>

            <!-- A page: its title stays put while the column under it scrolls, left-aligned up to PageMaxWidth. -->
            <Style TargetType="local:PageShell">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="local:PageShell">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    Margin="34,0,32,20"
                                    AutomationProperties.HeadingLevel="Level1"
                                    Style="{StaticResource TitleTextBlockStyle}"
                                    Text="{TemplateBinding Title}"
                                    TextTrimming="CharacterEllipsis" />
                                <ScrollViewer Grid.Row="1">
                                    <Grid Padding="32,0,32,32">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MaxWidth="{StaticResource PageMaxWidth}" />
                                            <ColumnDefinition Width="0" />
                                        </Grid.ColumnDefinitions>
                                        <ContentPresenter />
                                    </Grid>
                                </ScrollViewer>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- A group of cards: 24 above, 8 to its cards (a page's StackPanel adds 4 of those). -->
            <Style x:Key="SectionHeaderStyle" BasedOn="{StaticResource BodyStrongTextBlockStyle}" TargetType="TextBlock">
                <Setter Property="Margin" Value="1,24,0,4" />
                <Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
            </Style>

            <!-- The first group on a page: the page's title already gives it room. -->
            <Style x:Key="FirstSectionHeaderStyle" BasedOn="{StaticResource SectionHeaderStyle}" TargetType="TextBlock">
                <Setter Property="Margin" Value="1,0,0,4" />
            </Style>

            <!-- A sentence under a group of cards. -->
            <Style x:Key="SectionFootnoteStyle" BasedOn="{StaticResource CaptionTextBlockStyle}" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="Margin" Value="1,4,0,0" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!-- A card with free-form content (lists, the pairing code); SettingsCard is every other row. -->
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <!-- A flyout command: no fill until hovered, no outline. -->
            <Style x:Key="PanelButtonStyle" BasedOn="{StaticResource DefaultButtonStyle}" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </Style>

            <!-- A full-width row in the tray panel, its fill reaching a little past the text as Windows' flyouts do. -->
            <Style x:Key="PanelRowButtonStyle" BasedOn="{StaticResource PanelButtonStyle}" TargetType="Button">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Margin" Value="-11,0" />
                <Setter Property="MinHeight" Value="36" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>

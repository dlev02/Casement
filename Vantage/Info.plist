<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged into the generated Info.plist. vantage://connect/<device-id> opens a session;
	     widgets and Shortcuts use it. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLName</key>
			<string>me.drewlevinson.casement</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>vantage</string>
			</array>
		</dict>
	</array>
	<!-- Files received from the Mac go to Documents/Received, which these two keys show in
	     Files → On My iPad → Vantage. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<!-- "Open in Vantage" from other apps' share sheets: any file, as an alternate handler, is
	     queued for the connected (or most recent) Mac. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>File</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.data</string>
				<string>public.content</string>
			</array>
		</dict>
	</array>
	<!-- Files keep moving after Vantage is backgrounded: TransferBackgroundActivity submits a
	     BGContinuedProcessingTask (iOS 26) per run of files, as .transfers.<UUID>. -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>me.drewlevinson.casement.transfers.*</string>
	</array>
	<key>NSMicrophoneUsageDescription</key>
	<string>Casement uses the microphone when you dictate text to your computer.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Casement turns your speech into text on this device, or on your own computer when you choose to dictate there, and types it for you.</string>
</dict>
</plist>
